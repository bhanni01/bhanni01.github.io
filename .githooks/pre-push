#!/bin/sh
# Runs before every `git push` from this repo. Blocks the push when:
#   1. a commit being pushed has a Co-authored-by trailer or a "Generated with"
#      line. Every commit here is written by Nischal alone.
#   2. the site copy fails src/copy.test.js: the avoid-ai-writing detector plus
#      the "x, not y" contrast check.
#
# `npm install` turns this on through the "prepare" script in package.json.

zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
blocked=0

while read -r local_ref local_oid remote_ref remote_oid; do
  [ "$local_oid" = "$zero" ] && continue # deleting a remote branch

  if [ "$remote_oid" = "$zero" ] || ! git cat-file -e "$remote_oid" 2>/dev/null; then
    commits=$(git rev-list "$local_oid" --not --remotes)
  else
    commits=$(git rev-list "$remote_oid..$local_oid")
  fi

  for commit in $commits; do
    if git log -1 --format=%B "$commit" | grep -qiE '^co-authored-by:|generated with'; then
      echo "pre-push: $(git log -1 --format='%h "%s"' "$commit") has a co-author or generated-with line." >&2
      blocked=1
    fi
  done
done

if [ "$blocked" -ne 0 ]; then
  echo "pre-push: push blocked. Reword those commits, then push again." >&2
  exit 1
fi

if ! npm run --silent check:copy; then
  echo "pre-push: site copy failed the writing check, push blocked." >&2
  exit 1
fi
